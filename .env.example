# Cloudflare account settings. Keep real values in .env only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_WORKER_NAME=warhammer-ai-recommendations

# Django runtime only needs the URL and this separate service key.
# Copy the key privately from your own .env or redeploy to generate a new one.
RECOMMENDATIONS_URL=https://warhammer-ai-recommendations.canadyleon58.workers.dev
RECOMMENDATIONS_API_KEY=
RECOMMENDATIONS_TIMEOUT=45
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_SECRET_KEY=
